<%- include('layout/header', { 
  title: 'New Order Received! - FindMyMess Partner',
  previewText: `New order #${orderId} received for ${restaurantName}. Total: ₹${totalAmount}`
}) %>

<!-- Alert Banner -->
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #FEF2F2; border: 1px solid #FECACA; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;" align="center">
      <div style="font-size: 32px; line-height: 1; margin-bottom: 8px;">🔔</div>
      <h1 style="margin: 0 0 6px 0; font-size: 22px; font-weight: 800; color: #991B1B;">
        New Order Alert!
      </h1>
      <p style="margin: 0; font-size: 14px; color: #7F1D1D;">
        You have received a new order for <strong><%= restaurantName %></strong>.
      </p>
    </td>
  </tr>
</table>

<!-- Order Summary Box -->
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 16px;">
      <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td align="left" style="font-size: 13px; color: #64748B;">
            Order ID: <strong style="color: #0F172A;">#<%= orderId %></strong>
          </td>
          <td align="right" style="font-size: 13px; color: #64748B;">
            Received at: <strong style="color: #0F172A;"><%= typeof orderTime !== 'undefined' ? orderTime : 'Just now' %></strong>
          </td>
        </tr>
        <tr>
          <td align="left" style="padding-top: 8px; font-size: 13px; color: #64748B;">
            Payment: <span style="color: #10B981; font-weight: 700;">PAID ONLINE</span>
          </td>
          <td align="right" style="padding-top: 8px; font-size: 15px; font-weight: 800; color: #E23744;">
            Order Total: ₹<%= totalAmount %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Kitchen Checklist -->
<div style="background-color: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
  <h3 style="margin: 0 0 16px 0; font-size: 16px; font-weight: 700; color: #1E293B; display: flex; align-items: center;">
    🍳 Kitchen Preparation Checklist
  </h3>

  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse;">
    <thead>
      <tr style="border-bottom: 2px solid #E2E8F0;">
        <th align="center" width="50" style="padding: 8px 0; font-size: 12px; font-weight: 700; color: #64748B; text-transform: uppercase;">Qty</th>
        <th align="left" style="padding: 8px 12px; font-size: 12px; font-weight: 700; color: #64748B; text-transform: uppercase;">Item Name</th>
        <th align="right" style="padding: 8px 0; font-size: 12px; font-weight: 700; color: #64748B; text-transform: uppercase;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% if (items && items.length > 0) { %>
        <% items.forEach(function(item) { %>
          <tr style="border-bottom: 1px solid #F1F5F9;">
            <td align="center" style="padding: 12px 0;">
              <span style="display: inline-block; width: 28px; height: 28px; background-color: #FEF2F2; color: #E23744; border-radius: 6px; font-size: 14px; font-weight: 800; line-height: 28px; text-align: center;">
                <%= item.quantity %>x
              </span>
            </td>
            <td align="left" style="padding: 12px 12px; font-size: 15px; font-weight: 600; color: #1E293B;">
              <%= item.name %>
            </td>
            <td align="right" style="padding: 12px 0; font-size: 14px; color: #64748B;">
              ₹<%= item.total || (item.price * item.quantity) %>
            </td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>
</div>

<!-- Customer & Delivery Details -->
<div style="background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
  <p style="margin: 0 0 6px 0; font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px;">
    Customer Delivery Information
  </p>
  <p style="margin: 0 0 6px 0; font-size: 14px; font-weight: 500; color: #1E293B;">
    📍 <%= deliveryAddress %>
  </p>
  <% if (typeof customerPhone !== 'undefined' && customerPhone) { %>
    <p style="margin: 0; font-size: 13px; color: #64748B;">
      📞 Customer Mobile: <strong>+91 <%= customerPhone %></strong>
    </p>
  <% } %>
</div>

<%- include('layout/footer') %>
